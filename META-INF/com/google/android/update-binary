#!/sbin/sh
#####################
# FJGuard 安装入口（Magisk / KernelSU / APatch 通用）
#####################

umask 022
OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
    install_module
    exit 0
fi

echo "! 请先安装 Magisk / KernelSU / APatch"
exit 1
